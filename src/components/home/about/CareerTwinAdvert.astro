---
import ia2 from '../../../assets/svg/ia2.svg'
---

<div class="career-twin-inline">
  <span
    class="career-twin-visual"
    aria-hidden="true"
  >
    <span class="career-twin-pulse"></span>
    <span class="career-twin-pulse pulse-2"></span>

    <span class="career-twin-icon-wrapper">
      <img
        src={ia2.src}
        alt=""
        class="career-twin-icon"
      />
    </span>
  </span>

  <span class="career-twin-text">
    Looking for something specific about me? No need to go through the entire website.
  </span>

  <button type="button" class="career-twin-link" id="career-twin-link">
    Ask my assistant IA²
    <span aria-hidden="true">→</span>
  </button>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const link = document.getElementById('career-twin-link')
    const chat = document.getElementById('career-twin-chat')

    if (!link || !chat) return

    const openChat = () => {
      chat.classList.remove(
        'opacity-0',
        'pointer-events-none',
        'translate-y-3',
        'scale-95'
      )

      chat.classList.add(
        'opacity-100',
        'pointer-events-auto',
        'translate-y-0',
        'scale-100'
      )
    }

    link.addEventListener('click', openChat)
  })
</script>

<style>
  :global(:root) {
    --turquoise: #40e0d0;
  }

  .career-twin-inline {
    display: flex;
    align-items: center;
    justify-content: left;
    gap: 0.75rem;

    width: 100%;
    margin-bottom: 1.25rem;

    color: rgba(255, 255, 255, 0.6);
    font-size: 1rem;

    opacity: 0.9;
    transition: opacity 0.2s ease;
  }

  .career-twin-inline:hover {
    opacity: 1;
  }

  /* =========================
     IA² VISUAL
     ========================= */

  .career-twin-visual {
    position: relative;

    display: flex;
    align-items: center;
    justify-content: center;

    width: 34px;
    height: 34px;

    flex-shrink: 0;

    isolation: isolate;

    pointer-events: none;
  }

  /* Círculo principal */

  .career-twin-icon-wrapper {
    position: relative;
    z-index: 3;

    display: flex;
    align-items: center;
    justify-content: center;

    width: 34px;
    height: 34px;

    border: 1px solid rgba(64, 224, 208, 0.65);
    border-radius: 50%;

    background: rgba(5, 20, 22, 0.85);

    overflow: visible;

    box-shadow:
      0 0 5px rgba(64, 224, 208, 0.45),
      inset 0 0 7px rgba(64, 224, 208, 0.15);
  }

  /* SVG */

  .career-twin-icon {
    width: 40px;
    height: 40px;

    max-width: none;
    max-height: none;

    object-fit: contain;

    flex-shrink: 0;

    filter:
      drop-shadow(0 0 3px rgba(64, 224, 208, 0.8))
      drop-shadow(0 0 7px rgba(64, 224, 208, 0.35));
  }

  /* =========================
     ONDAS / PARPADEO
     ========================= */

  .career-twin-pulse {
    position: absolute;

    z-index: 1;

    width: 34px;
    height: 34px;

    border: 1px solid rgba(64, 224, 208, 0.55);
    border-radius: 50%;

    pointer-events: none;

    animation: career-twin-ripple 2.2s ease-out infinite;
  }

  .career-twin-pulse.pulse-2 {
    animation-delay: 1.1s;
  }

  @keyframes career-twin-ripple {
    0% {
      transform: scale(0.9);
      opacity: 0.8;
    }

    70% {
      transform: scale(1.7);
      opacity: 0;
    }

    100% {
      transform: scale(1.7);
      opacity: 0;
    }
  }

  /* =========================
     TEXT LINK
     ========================= */

  .career-twin-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;

    padding: 0;
    border: 0;

    color: var(--turquoise);
    background: transparent;

    font: inherit;
    font-weight: 600;

    cursor: pointer;
    text-decoration: none;

    transition:
      color 0.2s ease,
      gap 0.2s ease;
  }

  .career-twin-link:hover {
    color: #7ff5eb;
    gap: 0.45rem;
  }

  .career-twin-link span {
    font-size: 1rem;
    line-height: 1;
  }

  /* =========================
     MOBILE
     ========================= */

  @media (max-width: 640px) {
    .career-twin-inline {
      flex-wrap: wrap;
      gap: 0.4rem;

      margin-bottom: 2rem;
      padding-inline: 1rem;

      font-size: 0.8rem;
    }

    .career-twin-text {
      white-space: normal;
      text-align: center;
    }

    .career-twin-link {
      width: 100%;
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .career-twin-pulse {
      animation: none;
    }

    .career-twin-link {
      transition: none;
    }
  }
</style>