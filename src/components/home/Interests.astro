---
import { Image } from "astro:assets";
import Card from "../shared/Card.astro";
import INTERESTS from "../../assets/collections/interests.json";

const interestImages = import.meta.glob(
  "../../assets/images/interests/*",
  {
    eager: true,
    import: "default",
  }
);
---

<section
  id="interests"
  class="relative w-full min-h-[70vh] flex flex-col justify-center bg-center bg-cover overflow-hidden"
  style="
    background-image:
      linear-gradient(to bottom, rgba(0,0,0,0.7), rgba(0,0,0,0)),
      linear-gradient(to top, rgba(0,0,0,0.7), rgba(0,0,0,0)),
      linear-gradient(to bottom, black 0%, black 20px),
      url('/fondo-interests.jpg');
    background-size: cover, cover, 100% 20px, cover;
    background-position: center, center, bottom, center;
    background-repeat: no-repeat, no-repeat, no-repeat, no-repeat;
  "
>
  <div
    class="section-content flex flex-col items-center text-center px-4 py-16 md:py-24 max-w-6xl w-full"
  >

    <!-- TITLE -->
    <h2
      class="text-3xl md:text-5xl font-bold text-white mb-12 title-futuristic"
    >
      Other Interests
    </h2>

    <!-- CARDS -->
    <article class="grid gap-8 md:grid-cols-3 w-full">
      {INTERESTS.map((interest) => {
        const imagePath = `../../assets/images/interests/${interest.image}`;
        const image = interestImages[imagePath];

        return (
          <Card
            className="flex flex-col transform transition-transform duration-300 hover:scale-105"
          >

            <!-- IMAGE -->
            {image && (
              <Image
                src={image}
                alt={interest.title}
                width={600}
                height={400}
                class="w-full h-48 object-cover rounded-md mb-4 transition-transform duration-300 hover:scale-110"
              />
            )}

            <!-- TITLE -->
            <h3 class="card-title mb-2">
              {interest.title}
            </h3>

            <!-- DESCRIPTION -->
            {interest.description.map((paragraph) => (
              <p class="card-text mb-2 last:mb-0">
                {paragraph}
              </p>
            ))}

          </Card>
        );
      })}
    </article>

  </div>
</section>

<style>
  .card-title {
    color: #40e0d0;
    font-weight: 600;
  }

  .card-text {
    color: #b9b9b9;
  }

  .title-futuristic {
    position: relative;
    display: inline-block;
  }

  .title-futuristic::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -6px;
    width: 50%;
    height: 4px;
    background: linear-gradient(90deg, #0ff, #2ca3a3);
    border-radius: 2px;
    transform: skewX(-20deg);
    transition: width 0.3s ease;
  }

  .title-futuristic:hover::after {
    width: 70%;
  }
</style>