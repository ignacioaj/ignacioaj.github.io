---
import CareerTwinChat from './CareerTwinChat.astro'
import ia2 from '../../../../assets/svg/ia2.svg'
---

<div>
  <button
    id="career-twin-btn"
    type="button"
    aria-label="Ask IA²"
    aria-expanded="false"
    title="Ask IA²"
    class="w-12 h-12 md:w-14 md:h-14 rounded-full
           bg-white/15 backdrop-blur-md flex items-center justify-center
           shadow-lg
           transition-all duration-200
           hover:shadow-xl"
  >
    <img
      src={ia2.src}
      alt=""
      aria-hidden="true"
      class="w-full h-full object-contain"
    />
  </button>

  <CareerTwinChat />
</div>