---
import arrow from '../../../assets/svg/arrow-up.svg'
---

<button
  id="scroll-top-btn"
  aria-label="Scroll to top"
  title="Scroll to top"
  class="w-10 h-10 md:w-14 md:h-14 rounded-full
         bg-white/15 backdrop-blur-md flex items-center justify-center
         shadow-lg opacity-0 pointer-events-none
         transform translate-y-5
         transition-all duration-200
         hover:shadow-xl"
>
  <img
    src={arrow.src}
    alt=""
    aria-hidden="true"
    class="w-6 h-6 md:w-8 md:h-8 object-contain"
  />
</button>