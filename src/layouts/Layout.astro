---
import Footer from "../components/layout/Footer.astro";
import Navbar from "../components/layout/Navbar.astro";
import RightSideMenu from "../components/layout/right-side-menu/RightSideMenu.astro";
import "../styles/global.css";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Favicons -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon.png" />

    <meta name="generator" content={Astro.generator} />
    <title>{Astro.props.title}</title>
    <meta
      name="description"
      content="A minimalist web developer portfolio built with Astro and TailwindCSS"
    />
    <meta name="theme-color" content="#000000" />
  </head>

  <body class="bg-[#000000] text-white">
    <slot />

    <Footer />

    <RightSideMenu />

    <script is:inline>
      if (!window.ScrollLock) {
        window.ScrollLock = {
          scrollY: 0,

          lock() {
            this.scrollY = window.scrollY || window.pageYOffset;

            const html = document.documentElement;

            html.style.scrollbarGutter = "stable";
            html.style.overflow = "hidden";
          },

          unlock() {
            document.documentElement.style.overflow = "";

            const y = this.scrollY;

            requestAnimationFrame(() => {
              window.scrollTo(0, y);
            });
          }
        };
      }
    </script>

    <style is:global>
      html,
      body {
        margin: 0;
        padding: 0;
        box-sizing: border-box;

        overscroll-behavior: none;
        min-height: 100%;
      }

      *,
      *::before,
      *::after {
        box-sizing: inherit;
      }

      * {
        scroll-behavior: smooth;
      }
      html {
        scrollbar-width: thin;
        scrollbar-color: rgba(64, 224, 208, 0.65) transparent;
      }

      /* Chrome, Edge, Safari */
      html::-webkit-scrollbar {
        width: 8px;
      }

      html::-webkit-scrollbar-track {
        background: transparent;
      }

      html::-webkit-scrollbar-thumb {
        background: rgba(64, 224, 208, 0.55);
        border-radius: 999px;
        border: 2px solid transparent;
        background-clip: padding-box;

        transition:
          background 0.25s ease,
          border-width 0.25s ease,
          box-shadow 0.25s ease;
      }

      html::-webkit-scrollbar-thumb:hover {
        background: #40E0D0;
        border-width: 1px;
        box-shadow: 0 0 8px rgba(64, 224, 208, 0.35);
      }
    </style>
  </body>
</html>